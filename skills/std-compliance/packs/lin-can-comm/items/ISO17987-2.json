   "standard_key": "ISO17987-2",
   "clause": "5.4 表1",
   "title": "休眠命令识别",
   "requirement": "收到首字节为 0x00 的主请求帧（0x3C）即视为休眠命令，只解析第 1 字节，忽略第 2~8 字节，并进入总线休眠。",
   "applicability": {
    "bus": [
     "LIN"
    ],
    "role": [
     "responder"
    ],
    "features": [
     "sleep"
    ]
   },
   "method": "host-test",
   "check_hint": "注入 3C: 00 FF FF FF FF FF FF FF → 断言进入休眠（LinIf/LinSM 状态、EcuM 通知）；注入 00 12 34… 同样进入休眠。",
   "source": {
    "page": 16,
    "verified": true,
    "by": "claude",
    "date": "2026-11-26"
   }
  },
  {
